[Unit]
Description=Deskboard page and widget API
After=local-fs.target tailscaled.service
Wants=tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=__DESKBOARD_USER__
Group=__DESKBOARD_USER__
WorkingDirectory=__DESKBOARD_HOME__
ExecStart=/usr/bin/python3 -u __DESKBOARD_HOME__/serve.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
